# Local Supabase credentials for integration tests (Vitest `integration` project).
# These target the LOCAL stack only — never the remote project in `.env`/`.dev.vars`.
#
# Populate from the running local stack:
#   npx supabase start
#   npx supabase status
# Copy "Project URL" -> SUPABASE_URL, "Publishable" -> SUPABASE_ANON_KEY,
# "Secret" -> SUPABASE_SERVICE_ROLE_KEY. Then save this file as `.env.test`.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# Direct Postgres URL ("Database URL" from `npx supabase status`). Used only by
# integration fixtures to reach the auth schema (e.g. un-confirm a user to
# exercise the accept-invitation confirmation gate) — never by app code.
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
