---
import ProfileMenu from "@/components/ProfileMenu";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { t } from "@/lib/i18n";
import { getOwnProfileNames, type ProfileRow } from "@/lib/services/profiles";

interface Props {
  profileNames?: Pick<ProfileRow, "first_name" | "last_name">;
  showLanguageControls?: boolean;
}

const { profileNames, showLanguageControls = true } = Astro.props;
const { user, locale, supabase } = Astro.locals;
const returnTo = Astro.url.pathname + Astro.url.search;
let names = profileNames;
if (user && !names) {
  if (!supabase) throw new Error("header: authenticated client unavailable");
  try {
    names = await getOwnProfileNames(supabase);
  } catch (error) {
    // eslint-disable-next-line no-console -- never log private profile data
    console.error("header: profile lookup failed");
    throw error;
  }
}
---

<header class="border-border bg-background/60 sticky top-0 z-30 border-b backdrop-blur-sm">
  <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="text-foreground text-lg font-semibold tracking-tight">
      As<span class="text-primary">You</span>Wish
    </a>
    {
      user ? (
        <div class="flex items-center gap-4 text-sm">
          <a href="/dashboard" class="text-foreground hover:text-primary transition-colors">
            {t(locale, "header.dashboard")}
          </a>
          {/* client:only - Radix dropdown needs the client React instance (same as other islands). */}
          <ProfileMenu
            client:only="react"
            email={user.email ?? ""}
            firstName={names?.first_name ?? null}
            lastName={names?.last_name ?? null}
            locale={locale}
            returnTo={returnTo}
            showLanguageControls={showLanguageControls}
          >
            <span slot="fallback" class="bg-muted block size-8 rounded-full" aria-hidden="true" />
          </ProfileMenu>
        </div>
      ) : (
        <div class="flex items-center gap-3 text-sm">
          <LanguageSwitcher />
          <a href="/auth/signin" class="text-foreground hover:text-primary transition-colors">
            {t(locale, "header.signIn")}
          </a>
          <a
            href="/auth/signup"
            class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-lg px-4 py-2 font-medium transition-colors"
          >
            {t(locale, "header.signUp")}
          </a>
        </div>
      )
    }
  </div>
</header>
