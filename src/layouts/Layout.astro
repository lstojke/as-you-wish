---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { Toaster } from "@/components/ui/sonner";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

interface Props {
  title?: string;
  privatePage?: boolean;
  showToaster?: boolean;
  /** For pages without AppHeader (auth, share, invitation): floating PL/EN toggle. */
  languageSwitcher?: boolean;
}

const { title = "AsYouWish", privatePage = false, showToaster = true, languageSwitcher = false } = Astro.props;
---

<!doctype html>
<html lang={Astro.locals.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {privatePage && <meta name="robots" content="noindex, nofollow" />}
    {privatePage && <meta name="referrer" content="no-referrer" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    {languageSwitcher && <LanguageSwitcher class="bg-background/80 fixed top-4 right-4 z-40 backdrop-blur-sm" />}
    <slot />
    {showToaster && <Toaster client:load />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
