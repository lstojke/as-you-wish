---
import Layout from "@/layouts/Layout.astro";
import { acceptInvitation } from "@/lib/services/invitations";
import { getListRole } from "@/lib/services/lists";
import { t } from "@/lib/i18n";

export const prerender = false;

const { user, supabase, locale } = Astro.locals;

const invite = Astro.url.searchParams.get("invite");
const emailHint = Astro.url.searchParams.get("email") ?? "";

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (!invite || !UUID_RE.test(invite)) {
  return new Response(null, { status: 404 });
}

// Unauthenticated invitees are bounced through sign-in and returned here.
// The email is an untrusted prefill hint only - the RPC re-verifies from the session.
if (!user || !supabase) {
  const returnTo = `/invitations/accept?invite=${invite}`;
  const params = new URLSearchParams({ return: returnTo });
  if (emailHint) params.set("email", emailHint);
  return Astro.redirect(`/auth/signin?${params.toString()}`);
}

const result = await acceptInvitation(supabase, { invitationId: invite });

if (!result.ok && result.reason === "not_found") {
  return new Response(null, { status: 404 });
}

const role = result.ok ? await getListRole(supabase, result.listId) : null;
if (result.ok && !role) return new Response(null, { status: 404 });
const heading = result.ok
  ? t(locale, "invitation.acceptedHeading")
  : result.reason === "mismatch"
    ? t(locale, "invitation.mismatchHeading")
    : result.reason === "not_confirmed"
      ? t(locale, "invitation.notConfirmedHeading")
      : t(locale, "invitation.failedHeading");

const detail = result.ok
  ? role === "collaborator"
    ? t(locale, "invite.collaboratorDescription")
    : role === "viewer"
      ? t(locale, "invite.viewerDescription")
      : role === "owner"
        ? t(locale, "invitation.acceptedOwner")
        : t(locale, "invitation.failedDetail")
  : result.reason === "mismatch"
    ? t(locale, "invitation.mismatchDetail")
    : result.reason === "not_confirmed"
      ? t(locale, "invitation.notConfirmedDetail")
      : t(locale, "invitation.failedDetail");
---

<Layout title={t(locale, "invitation.pageTitle")} languageSwitcher>
  <main class="mx-auto w-full max-w-md px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-2xl font-semibold tracking-tight">{heading}</h1>
    <p class="text-muted-foreground mt-3 text-sm">{detail}</p>
    {
      result.ok && role && (
        <a href={`/lists/${result.listId}`} class="mt-6 block text-sm font-medium underline underline-offset-4">
          {t(locale, "invitation.openList")}
        </a>
      )
    }
    <a
      href="/dashboard"
      class="text-muted-foreground hover:text-foreground mt-6 inline-block text-sm underline-offset-4 hover:underline"
    >
      {t(locale, "common.backToLists")}
    </a>
  </main>
</Layout>
