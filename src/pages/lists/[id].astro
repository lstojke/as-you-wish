---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import ListDetail from "@/components/lists/ListDetail";
import { getListById, getListRole, type ListRow, type ListRole } from "@/lib/services/lists";
import { listItems, listReservedItemIds, type ItemRow } from "@/lib/services/items";
import { listMyReservedItemIds } from "@/lib/services/reservations";
import { listInvitations, type InvitationRow } from "@/lib/services/invitations";
import { getDefaultCurrency } from "@/lib/services/profiles";
import { SYSTEM_DEFAULT_CURRENCY } from "@/lib/currency";
import { t } from "@/lib/i18n";

export const prerender = false;

const { user, supabase } = Astro.locals;
if (!user || !supabase) {
  throw new Error("lists/[id]: middleware should have redirected unauthenticated requests");
}

const { id } = Astro.params;

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (!id || !UUID_RE.test(id)) {
  return new Response(null, { status: 404 });
}

let maybeList: ListRow | null = null;
let items: ItemRow[] = [];
let reservedItemIds: string[] = [];
let myReservedItemIds: string[] = [];
let invitations: InvitationRow[] = [];
let defaultCurrency: string = SYSTEM_DEFAULT_CURRENCY;
let role: ListRole | null = null;
try {
  maybeList = await getListById(supabase, id);
  if (maybeList) {
    role = await getListRole(supabase, id);
    if (!role) return new Response(null, { status: 404 });
    items = await listItems(supabase, id);
    [reservedItemIds, myReservedItemIds] = await Promise.all([
      listReservedItemIds(supabase, id),
      listMyReservedItemIds(
        supabase,
        items.map((i) => i.id),
      ),
    ]);
    if (role === "owner") invitations = await listInvitations(supabase, id);
    if (role !== "viewer") defaultCurrency = await getDefaultCurrency(supabase);
  }
} catch (e) {
  // eslint-disable-next-line no-console -- surface SSR load failures in Wrangler tail
  console.error("lists/[id]: failed to load", e);
  return new Response(t(Astro.locals.locale, "errors.unavailable"), { status: 503 });
}

if (!maybeList || !role) {
  return new Response(null, { status: 404 });
}

const list = maybeList;
---

<Layout title={list.title}>
  <AppHeader />
  <main class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    {
      /* client:only required - react-hook-form in AddItemForm causes React SSR instance mismatch with client:load (same root cause as DashboardLists). SSR data fetched above and passed as props. */
    }
    <ListDetail
      client:only="react"
      list={list}
      initialItems={items}
      reservedItemIds={reservedItemIds}
      myReservedItemIds={myReservedItemIds}
      initialInvitations={invitations}
      role={role}
      defaultCurrency={defaultCurrency}
      locale={Astro.locals.locale}
    />
  </main>
</Layout>
