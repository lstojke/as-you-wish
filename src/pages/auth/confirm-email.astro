---
import Layout from "@/layouts/Layout.astro";
import { t } from "@/lib/i18n";

const { locale } = Astro.locals;

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: t(locale, "auth.confirm.successHeading"),
      description: t(locale, "auth.confirm.successBody"),
      linkText: t(locale, "auth.confirm.successLink"),
    }
  : {
      emoji: "📧",
      heading: t(locale, "auth.confirm.checkHeading"),
      description: t(locale, "auth.confirm.checkBody"),
      linkText: t(locale, "auth.confirm.checkLink"),
    };
---

<Layout title={content.heading} languageSwitcher>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="border-border bg-card text-card-foreground w-full max-w-sm rounded-2xl border p-8 text-center backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="text-foreground mb-3 text-2xl font-bold">
        {content.heading}
      </h1>
      <p class="text-muted-foreground mb-6">{content.description}</p>
      <a
        href="/auth/signin"
        class="text-primary focus-visible:ring-ring focus-visible:ring-offset-card rounded-sm text-sm hover:underline focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
      >
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
