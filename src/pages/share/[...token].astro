---
import Layout from "@/layouts/Layout.astro";
import { canAccessSharedList, readListShare } from "@/lib/services/list-shares";
import { listShareTokenSchema, sharedStoreLinkSchema } from "@/lib/schemas/list-shares";
import { formatPrice } from "@/lib/format-price";
import type { SharedList } from "@/types";

export const prerender = false;

const privacyHeaders = {
  "Cache-Control": "private, no-store",
  "Referrer-Policy": "no-referrer",
  "X-Robots-Tag": "noindex, nofollow",
};
for (const [name, value] of Object.entries(privacyHeaders)) {
  Astro.response.headers.set(name, value);
}

const { user, supabase } = Astro.locals;
const parsedToken = listShareTokenSchema.safeParse(Astro.params.token);
let list: SharedList | null = null;
let member = false;
let failed = false;

if (parsedToken.success) {
  try {
    if (!supabase) throw new Error("Supabase is not configured");
    list = await readListShare(supabase, parsedToken.data);
    if (list && user) {
      member = await canAccessSharedList(supabase, list.list_id);
    }
  } catch {
    // Never include the request URL, token, or RPC error in diagnostics.
    // eslint-disable-next-line no-console -- surface SSR failures without bearer secrets
    console.error("share: failed to load shared list");
    failed = true;
    list = null;
  }
}

if (list && member) {
  return new Response(null, {
    status: 302,
    headers: { ...privacyHeaders, Location: `/lists/${list.list_id}` },
  });
}

if (!list) {
  Astro.response.status = failed ? 503 : 404;
}
---

<Layout title={list?.title ?? "Wishlist unavailable"} privatePage showToaster={false}>
  <main class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    {
      list ? (
        <>
          <h1 class="mb-2 text-3xl font-semibold break-words">{list.title}</h1>
          <p class="text-muted-foreground mb-8 text-sm">Read-only wishlist</p>
          {list.items.length === 0 ? (
            <p class="text-muted-foreground text-sm">No items yet.</p>
          ) : (
            <ul class="space-y-3">
              {list.items.map((item) => {
                const safeLink = sharedStoreLinkSchema.safeParse(item.link);
                return (
                  <li class="border-border space-y-2 rounded-lg border px-4 py-3">
                    <h2 class="font-medium break-words">{item.title}</h2>
                    {item.notes && <p class="text-sm break-words whitespace-pre-wrap">{item.notes}</p>}
                    {item.price_cents !== null && item.currency !== null && (
                      <p class="text-muted-foreground text-sm">
                        {formatPrice(item.price_cents, item.currency, Astro.locals.locale)}
                      </p>
                    )}
                    {safeLink.success ? (
                      <a
                        href={safeLink.data}
                        target="_blank"
                        rel="noopener noreferrer"
                        referrerpolicy="no-referrer"
                        class="text-primary block text-sm break-all underline-offset-4 hover:underline"
                      >
                        {safeLink.data}
                      </a>
                    ) : item.link ? (
                      <p class="text-muted-foreground text-sm">Store link unavailable.</p>
                    ) : null}
                  </li>
                );
              })}
            </ul>
          )}
        </>
      ) : (
        <>
          <h1 class="mb-2 text-3xl font-semibold">Wishlist unavailable</h1>
          <p class="text-muted-foreground">
            {failed
              ? "We could not load this wishlist. Please try again later."
              : "This sharing link is unavailable. Ask the list owner for a new link."}
          </p>
        </>
      )
    }
  </main>
</Layout>
