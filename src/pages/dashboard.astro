---
import Layout from "@/layouts/Layout.astro";
import DashboardLists from "@/components/dashboard/DashboardLists";
import { listOwnedAndShared, type ListRow } from "@/lib/services/lists";

export const prerender = false;

const { user, supabase } = Astro.locals;
if (!user || !supabase) {
  throw new Error("dashboard: middleware should have redirected unauthenticated requests");
}
let owned: ListRow[] = [];
let shared: ListRow[] = [];
try {
  ({ owned, shared } = await listOwnedAndShared(supabase));
} catch (e) {
  // eslint-disable-next-line no-console -- surface SSR load failures in Wrangler tail
  console.error("dashboard: failed to load lists", e);
}
---

<Layout title="Dashboard">
  <main class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Your wish lists</h1>
        <p class="text-muted-foreground text-sm">
          Signed in as <span class="text-foreground font-medium">{user.email}</span>
        </p>
      </div>
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="text-muted-foreground hover:text-foreground text-sm underline-offset-4 hover:underline"
        >
          Sign out
        </button>
      </form>
    </header>

    {
      /* client:only prevents Astro SSR from rendering this island — required because react-hook-form and Radix UI primitives inside the dialog resolve to a different React instance than Astro's SSR renderer, producing an "Invalid hook call" crash at runtime. SSR data is fetched above and passed as props. */
    }
    <DashboardLists client:only="react" owned={owned} shared={shared} />
  </main>
</Layout>
