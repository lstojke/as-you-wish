---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import DashboardLists from "@/components/dashboard/DashboardLists";
import { listOwnedAndShared, type ListRow } from "@/lib/services/lists";
import { t } from "@/lib/i18n";
import { listGroups, listGroupMemberships } from "@/lib/services/list-groups";
import type { PersonalListGroup, ListGroupMembership } from "@/components/dashboard/group-types";

export const prerender = false;

const { user, supabase, locale } = Astro.locals;
if (!user || !supabase) {
  throw new Error("dashboard: middleware should have redirected unauthenticated requests");
}
let owned: ListRow[] = [];
let shared: ListRow[] = [];
let listsLoadFailed = false;
let groups: PersonalListGroup[] = [];
let memberships: ListGroupMembership[] = [];
let groupsLoadFailed = false;
for (const delayMs of [0, 250, 750]) {
  if (delayMs > 0) {
    await new Promise((resolve) => setTimeout(resolve, delayMs));
  }
  try {
    ({ owned, shared } = await listOwnedAndShared(supabase));
    listsLoadFailed = false;
    break;
  } catch {
    listsLoadFailed = true;
  }
}
try {
  [groups, memberships] = await Promise.all([listGroups(supabase), listGroupMemberships(supabase)]);
  const accessibleListIds = new Set([...owned, ...shared].map((list) => list.id));
  memberships = memberships.filter((membership) => accessibleListIds.has(membership.list_id));
} catch {
  groupsLoadFailed = true;
}
const selectedGroupId = Astro.url.searchParams.get("group");
---

<Layout title={t(locale, "dashboard.pageTitle")}>
  <AppHeader />
  <main class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    {
      /* client:only prevents Astro SSR from rendering this island - required because react-hook-form and Radix UI primitives inside the dialog resolve to a different React instance than Astro's SSR renderer, producing an "Invalid hook call" crash at runtime. SSR data is fetched above and passed as props. */
    }
    <DashboardLists
      client:only="react"
      locale={locale}
      owned={owned}
      shared={shared}
      loadError={listsLoadFailed}
      groups={groups}
      memberships={memberships}
      groupsLoadError={groupsLoadFailed}
      selectedGroupId={selectedGroupId}
    />
  </main>
</Layout>
