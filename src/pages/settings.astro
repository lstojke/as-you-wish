---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import ProfileSettings from "@/components/settings/ProfileSettings";
import { getOwnProfile } from "@/lib/services/profiles";
import { listImportantDates } from "@/lib/services/important-dates";
import { profileDetailsSchema, profilePreferencesSchema } from "@/lib/schemas/profile";
import { t } from "@/lib/i18n";

export const prerender = false;

const { user, supabase, locale } = Astro.locals;
if (!user || !supabase) {
  throw new Error("settings: middleware should have redirected unauthenticated requests");
}

const profile = await getOwnProfile(supabase);
const importantDates = await listImportantDates(supabase);
const settings = {
  ...profileDetailsSchema.parse({ firstName: profile.first_name, lastName: profile.last_name }),
  ...profilePreferencesSchema.parse({ defaultCurrency: profile.default_currency, language: profile.language }),
};
---

<Layout title={t(locale, "settings.pageTitle")}>
  <AppHeader profileNames={profile} showLanguageControls={false} />
  <main class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <a href="/dashboard" class="text-muted-foreground hover:text-foreground text-sm transition-colors">
      {t(locale, "common.backToLists")}
    </a>
    <header class="mt-4 mb-8">
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t(locale, "settings.heading")}</h1>
    </header>
    {/* client:only - react-hook-form + Radix need the client React instance (same as DashboardLists). */}
    <ProfileSettings
      client:only="react"
      locale={locale}
      email={user.email ?? ""}
      profile={settings}
      importantDates={importantDates}
    />
  </main>
</Layout>
